#include "IUnityInterface.h"

#include <android/native_window.h>
#include <android/log.h>
#include <media/NdkMediaCodec.h>
#include <media/NdkMediaFormat.h>

#include <algorithm>
#include <atomic>
#include <condition_variable>
#include <cstdint>
#include <cstring>
#include <deque>
#include <mutex>
#include <string>
#include <thread>
#include <vector>

#define VS_CODEC_LOG_TAG "VideoStreamNativeCodec"
#define VS_LOGI(...) __android_log_print(ANDROID_LOG_INFO, VS_CODEC_LOG_TAG, __VA_ARGS__)
#define VS_LOGE(...) __android_log_print(ANDROID_LOG_ERROR, VS_CODEC_LOG_TAG, __VA_ARGS__)

#ifndef COLOR_FormatSurface
#define COLOR_FormatSurface 0x7F000789
#endif

// PTS epoch (ms) maintained by the EGL render plugin; the codec input PTS is set
// via eglPresentationTimeANDROID against this same clock, so native-side encode
// latency can be computed entirely inside the plugin clock (A3).
extern "C" double VSMedia_GetStartMs();

// Native direct send (C4/native-send): the codec loop pushes encoded frames
// straight into the UDP send queue, bypassing the C# poll round-trip.
extern "C" int VSMedia_UdpSendFrame(
    int frameId, int64_t ptsUs, const uint8_t* data, int size,
    bool isConfig, bool isKeyFrame, const char* mime, uint32_t sequence);

namespace
{
    constexpr uint8_t kStartCode4[] = {0, 0, 0, 1};
    struct EncodedFrame
    {
        std::vector<uint8_t> data;
        bool isConfig = false;
        bool isKeyFrame = false;
        int64_t ptsUs = 0;
        float encodeMs = 0.0f;
    };

    double NowMs()
    {
        return std::chrono::duration<double, std::milli>(
            std::chrono::steady_clock::now().time_since_epoch()).count();
    }

    AMediaCodec* gCodec = nullptr;
    ANativeWindow* gInputWindow = nullptr;
    std::thread gCodecThread;
    std::mutex gCodecMutex;
    std::condition_variable gCodecCv;
    std::deque<EncodedFrame> gEncodedFrames;
    std::atomic<bool> gCodecRunning{false};
    std::string gMime;
    std::vector<uint8_t> gCsd;
    // Native direct send state (C4/native-send).
    std::atomic<bool> g_udpReady{false};
    int s_frameId = 0;
    uint32_t s_sequence = 0;

    bool HasStartCode(const std::vector<uint8_t>& data)
    {
        if (data.size() >= 4 &&
            data[0] == 0 && data[1] == 0 && data[2] == 0 && data[3] == 1)
        {
            return true;
        }
        return data.size() >= 3 &&
               data[0] == 0 && data[1] == 0 && data[2] == 1;
    }

    std::vector<uint8_t> EnsureAnnexB(const uint8_t* data, int size)
    {
        if (data == nullptr || size <= 0)
        {
            return {};
        }

        std::vector<uint8_t> raw(data, data + size);
        if (HasStartCode(raw))
        {
            return raw;
        }

        std::vector<uint8_t> out;
        out.reserve(static_cast<size_t>(size) + 64);
        size_t offset = 0;
        while (offset + 4 <= static_cast<size_t>(size))
        {
            uint32_t len =
                (static_cast<uint32_t>(data[offset]) << 24) |
                (static_cast<uint32_t>(data[offset + 1]) << 16) |
                (static_cast<uint32_t>(data[offset + 2]) << 8) |
                static_cast<uint32_t>(data[offset + 3]);
            offset += 4;
            if (len == 0 || offset + len > static_cast<size_t>(size))
            {
                return raw;
            }
            out.insert(out.end(), kStartCode4, kStartCode4 + 4);
            out.insert(out.end(), data + offset, data + offset + len);
            offset += len;
        }

        return out.empty() || offset != static_cast<size_t>(size) ? raw : out;
    }

    std::vector<std::vector<uint8_t>> SplitNalUnits(const std::vector<uint8_t>& data)
    {
        std::vector<std::vector<uint8_t>> nalus;
        size_t start = 0;
        size_t i = 0;
        while (i < data.size())
        {
            bool startCode4 = i + 4 <= data.size() &&
                              data[i] == 0 && data[i + 1] == 0 &&
                              data[i + 2] == 0 && data[i + 3] == 1;
            bool startCode3 = !startCode4 && i + 3 <= data.size() &&
                              data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1;
            if (!startCode4 && !startCode3)
            {
                ++i;
                continue;
            }

            if (i > start)
            {
                nalus.emplace_back(data.begin() + static_cast<ptrdiff_t>(start),
                                   data.begin() + static_cast<ptrdiff_t>(i));
            }
            i += startCode4 ? 4 : 3;
            start = i;
        }
        if (start < data.size())
        {
            nalus.emplace_back(data.begin() + static_cast<ptrdiff_t>(start),
                               data.end());
        }
        return nalus;
    }

    bool IsParameterSet(const std::vector<uint8_t>& nalu, const std::string& mime)
    {
        if (nalu.empty())
        {
            return false;
        }

        uint8_t type = nalu[0];
        if (mime.find("hevc") != std::string::npos)
        {
            type = static_cast<uint8_t>((nalu[0] & 0x7E) >> 1);
            return type == 32 || type == 33 || type == 34;
        }

        type = static_cast<uint8_t>(nalu[0] & 0x1F);
        return type == 7 || type == 8;
    }

    std::vector<uint8_t> ExtractParameterSets(
        const std::vector<uint8_t>& data,
        const std::string& mime)
    {
        auto nalus = SplitNalUnits(data);
        int first = -1;
        for (int i = 0; i < static_cast<int>(nalus.size()); ++i)
        {
            if (IsParameterSet(nalus[i], mime))
            {
                first = i;
                break;
            }
        }
        if (first < 0)
        {
            return {};
        }

        int end = first;
        while (end < static_cast<int>(nalus.size()) &&
               IsParameterSet(nalus[end], mime))
        {
            ++end;
        }
        if (end == first)
        {
            return {};
        }

        size_t total = 0;
        for (int i = first; i < end; ++i)
        {
            total += nalus[i].size() + 4;
        }
        std::vector<uint8_t> out;
        out.reserve(total);
        for (int i = first; i < end; ++i)
        {
            out.insert(out.end(), kStartCode4, kStartCode4 + 4);
            out.insert(out.end(), nalus[i].begin(), nalus[i].end());
        }
        return out;
    }

    bool StartsWith(const std::vector<uint8_t>& data, const std::vector<uint8_t>& prefix)
    {
        return data.size() >= prefix.size() &&
               std::equal(prefix.begin(), prefix.end(), data.begin());
    }

    std::vector<uint8_t> Concat(
        const std::vector<uint8_t>& prefix,
        const std::vector<uint8_t>& suffix)
    {
        std::vector<uint8_t> out;
        out.reserve(prefix.size() + suffix.size());
        out.insert(out.end(), prefix.begin(), prefix.end());
        out.insert(out.end(), suffix.begin(), suffix.end());
        return out;
    }

    void CodecLoop()
    {
        int logCount = 0;
        while (gCodecRunning.load())
        {
            AMediaCodecBufferInfo info{};
            // 10ms poll: kept at the platform default; shorter timeouts only spin
            // the background thread without reducing main-thread poll cost.
            // (A2 tested 1ms -> ENC 59.5/61.6 vs baseline 55.9/64.5, no net gain, reverted)
            ssize_t index = AMediaCodec_dequeueOutputBuffer(gCodec, &info, 10000);
            if (index < 0)
            {
                continue;
            }

            if (index == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED)
            {
                continue;
            }

            size_t bufferSize = 0;
            uint8_t* buffer = AMediaCodec_getOutputBuffer(gCodec, index, &bufferSize);
            if (buffer != nullptr && info.size > 0)
            {
                EncodedFrame frame;
                frame.isConfig = (info.flags & AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG) != 0;
                frame.isKeyFrame = (info.flags & 1) != 0;
                frame.ptsUs = info.presentationTimeUs;
                // A3: encode latency measured entirely in the plugin clock.
                // input time = PTS epoch + ptsUs (the EGL plugin stamps PTS against
                // g_startMs), output time = dequeue stamp -> no C# poll cadence noise.
                frame.encodeMs = static_cast<float>(
                    NowMs() - (VSMedia_GetStartMs() + frame.ptsUs / 1000.0));

                frame.data = EnsureAnnexB(buffer + info.offset, info.size);
                if (frame.data.empty())
                {
                    AMediaCodec_releaseOutputBuffer(gCodec, index, false);
                    continue;
                }

                if (frame.isConfig)
                {
                    gCsd = frame.data;
                }
                else if (frame.isKeyFrame)
                {
                    if (gCsd.empty())
                    {
                        gCsd = ExtractParameterSets(frame.data, gMime);
                    }
                    if (!gCsd.empty() && !StartsWith(frame.data, gCsd))
                    {
                        frame.data = Concat(gCsd, frame.data);
                    }
                }

                // Native direct send (C4/native-send): push to the UDP queue at
                // dequeue time, skipping the C# poll round-trip (saves up to
                // ~16.7ms per frame). Guarded by g_udpReady so the config frame
                // is not dropped before UDP targets exist.
                if (g_udpReady.load())
                {
                    VSMedia_UdpSendFrame(
                        s_frameId++,
                        frame.ptsUs,
                        frame.data.data(),
                        static_cast<int>(frame.data.size()),
                        frame.isConfig,
                        frame.isKeyFrame,
                        gMime.c_str(),
                        ++s_sequence);
                }

                if (++logCount <= 5 || logCount % 60 == 0)
                {
                    uint8_t head[8] = {};
                    std::memcpy(head, frame.data.data(),
                                std::min<size_t>(sizeof(head), frame.data.size()));
                    VS_LOGI("encoded count=%d size=%zu key=%d config=%d "
                            "head=%02x%02x%02x%02x %02x%02x%02x%02x",
                            logCount, frame.data.size(), frame.isKeyFrame, frame.isConfig,
                            head[0], head[1], head[2], head[3],
                            head[4], head[5], head[6], head[7]);
                }

                {
                    std::lock_guard<std::mutex> lock(gCodecMutex);
                    gEncodedFrames.push_back(std::move(frame));
                }
                gCodecCv.notify_one();
            }

            AMediaCodec_releaseOutputBuffer(gCodec, index, false);
        }
    }
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_CodecStart(
    int width,
    int height,
    int bitrate,
    int frameRate,
    int iFrameIntervalSeconds,
    const char* mime)
{
    if (gCodecRunning.load())
    {
        return 0;
    }

    AMediaFormat* format = AMediaFormat_new();
    AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, mime);
    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_WIDTH, width);
    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_HEIGHT, height);
    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_COLOR_FORMAT, COLOR_FormatSurface);
    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_BIT_RATE, bitrate);
    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_FRAME_RATE, frameRate);
    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_I_FRAME_INTERVAL, iFrameIntervalSeconds);
    AMediaFormat_setInt32(format, "low-latency", 1);
    AMediaFormat_setInt32(format, "operating-rate", frameRate * 3);
    AMediaFormat_setInt32(format, "priority", 0); // NOTE: priority=1 (realtime) tested 2026-08-18 -> ENC 55.9->72.5ms, reverted
    AMediaFormat_setInt32(format, "latency", 0);
    AMediaFormat_setInt32(format, "bitrate-mode", 2);
    AMediaFormat_setInt32(format, "max-b-frames", 0);
    AMediaFormat_setInt32(format, "prepend-sps-pps-to-idr-frames", 1);

    AMediaCodec* codec = AMediaCodec_createEncoderByType(mime);
    if (codec == nullptr)
    {
        VS_LOGE("AMediaCodec_createEncoderByType failed");
        AMediaFormat_delete(format);
        return 0;
    }

    media_status_t status = AMediaCodec_configure(
        codec,
        format,
        nullptr,
        nullptr,
        AMEDIACODEC_CONFIGURE_FLAG_ENCODE);
    AMediaFormat_delete(format);
    if (status != AMEDIA_OK)
    {
        VS_LOGE("AMediaCodec_configure failed: %d", status);
        AMediaCodec_delete(codec);
        return 0;
    }

    ANativeWindow* inputWindow = nullptr;
    status = AMediaCodec_createInputSurface(codec, &inputWindow);
    if (status != AMEDIA_OK || inputWindow == nullptr)
    {
        VS_LOGE("AMediaCodec_createInputSurface failed: %d", status);
        AMediaCodec_delete(codec);
        return 0;
    }

    status = AMediaCodec_start(codec);
    if (status != AMEDIA_OK)
    {
        VS_LOGE("AMediaCodec_start failed: %d", status);
        AMediaCodec_delete(codec);
        ANativeWindow_release(inputWindow);
        return 0;
    }

    gCodec = codec;
    gInputWindow = inputWindow;
    gMime = mime != nullptr ? mime : "video/avc";
    gCsd.clear();
    s_frameId = 0;
    s_sequence = 0;
    g_udpReady.store(false);
    gCodecRunning.store(true);
    // CodecLoop thread is started by VSMedia_CodecSetUdpReady(1) so no frame
    // (including the config buffer) is dequeued before UDP targets exist.
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT void VSMedia_CodecSetUdpReady(int ready)
{
    bool was = g_udpReady.exchange(ready != 0);
    if (ready && !was && gCodecRunning.load() && !gCodecThread.joinable())
    {
        gCodecThread = std::thread(CodecLoop);
    }
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_CodecStop()
{
    if (!gCodecRunning.exchange(false))
    {
        return 1;
    }

    if (gCodecThread.joinable())
    {
        gCodecThread.join();
    }

    if (gCodec != nullptr)
    {
        AMediaCodec_stop(gCodec);
        AMediaCodec_delete(gCodec);
        gCodec = nullptr;
    }

    if (gInputWindow != nullptr)
    {
        ANativeWindow_release(gInputWindow);
        gInputWindow = nullptr;
    }

    {
        std::lock_guard<std::mutex> lock(gCodecMutex);
        gEncodedFrames.clear();
    }
    gCsd.clear();
    gMime.clear();
    g_udpReady.store(false);
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT void* VSMedia_CodecGetInputSurface()
{
    return gInputWindow;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_CodecDequeueFrame(
    uint8_t* buffer,
    int capacity,
    int* size,
    bool* isConfig,
    bool* isKeyFrame,
    int64_t* ptsUs,
    float* encodeMs)
{
    EncodedFrame frame;
    {
        std::lock_guard<std::mutex> lock(gCodecMutex);
        if (gEncodedFrames.empty())
        {
            return 0;
        }
        frame = std::move(gEncodedFrames.front());
        gEncodedFrames.pop_front();
    }

    if (buffer == nullptr || capacity < static_cast<int>(frame.data.size()))
    {
        return 0;
    }

    std::memcpy(buffer, frame.data.data(), frame.data.size());
    if (size != nullptr) *size = static_cast<int>(frame.data.size());
    if (isConfig != nullptr) *isConfig = frame.isConfig;
    if (isKeyFrame != nullptr) *isKeyFrame = frame.isKeyFrame;
    if (ptsUs != nullptr) *ptsUs = frame.ptsUs;
    if (encodeMs != nullptr) *encodeMs = frame.encodeMs;
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT void VSMedia_CodecRequestKeyFrame()
{
    if (gCodec == nullptr)
    {
        return;
    }

    AMediaFormat* params = AMediaFormat_new();
    AMediaFormat_setInt32(params, "request-sync-frame", 0);
    AMediaCodec_setParameters(gCodec, params);
    AMediaFormat_delete(params);
}
