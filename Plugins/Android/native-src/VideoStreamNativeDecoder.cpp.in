#include "IUnityInterface.h"

#include <android/log.h>
#include <android/native_window_jni.h>
#include <jni.h>
#include <media/NdkMediaCodec.h>
#include <media/NdkMediaFormat.h>

#include <algorithm>
#include <atomic>
#include <chrono>
#include <cstdint>
#include <cstring>
#include <mutex>
#include <string>
#include <thread>
#include <vector>

#define VS_DECODER_LOG_TAG "VideoStreamNativeDecoder"
#define VS_DLOGI(...) __android_log_print(ANDROID_LOG_INFO, VS_DECODER_LOG_TAG, __VA_ARGS__)
#define VS_DLOGE(...) __android_log_print(ANDROID_LOG_ERROR, VS_DECODER_LOG_TAG, __VA_ARGS__)

extern "C" int VSMedia_UdpPollPacket(uint8_t* buffer, int capacity, int* size);
extern "C" int VSMedia_UdpSendIdrRequest();
extern "C" int VSMedia_DecoderProcessPackets();
extern "C" JavaVM* VSMedia_GetJavaVm();

namespace
{
    constexpr int kFrameHeaderSize = 18;
    constexpr uint16_t kFlagIdr = 0x0001;
    constexpr uint16_t kFlagConfig = 0x0002;
    constexpr uint16_t kFlagCodecAvc = 0x0010;
    constexpr uint16_t kFlagCodecHevc = 0x0020;
    constexpr uint8_t kStartCode4[] = {0, 0, 0, 1};

    std::mutex gDecoderMutex;
    AMediaCodec* gDecoder = nullptr;
    std::thread gDecoderThread;
    std::atomic<bool> gDecoderRunning{false};
    std::thread gProcessThread;
    bool gDecoderActive = false;
    bool gDecoderConfigured = false;
    std::string gMime = "video/avc";
    std::vector<uint8_t> gCsd;
    std::vector<std::vector<uint8_t>> gDecoderCsdBuffers;
    std::vector<uint8_t> gConfiguredCsd;
    ANativeWindow* gOutputWindow = nullptr;
    int32_t gLastFrameId = -1;
    bool gDamaged = false;
    int64_t gLastIdrRequestMs = 0;

    int64_t NowMs()
    {
        return std::chrono::duration_cast<std::chrono::milliseconds>(
            std::chrono::steady_clock::now().time_since_epoch()).count();
    }

    uint32_t ReadU16(const uint8_t* data)
    {
        return (static_cast<uint32_t>(data[0]) << 8) | data[1];
    }

    uint32_t ReadU32(const uint8_t* data)
    {
        return (static_cast<uint32_t>(data[0]) << 24) |
               (static_cast<uint32_t>(data[1]) << 16) |
               (static_cast<uint32_t>(data[2]) << 8) |
               static_cast<uint32_t>(data[3]);
    }

    std::vector<std::vector<uint8_t>> SplitNalUnits(const std::vector<uint8_t>& data)
    {
        std::vector<std::vector<uint8_t>> nalus;
        size_t start = 0;
        size_t i = 0;
        while (i < data.size())
        {
            bool startCode4 = i + 4 <= data.size() &&
                              data[i] == 0 && data[i + 1] == 0 &&
                              data[i + 2] == 0 && data[i + 3] == 1;
            bool startCode3 = !startCode4 && i + 3 <= data.size() &&
                              data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1;
            if (!startCode4 && !startCode3)
            {
                ++i;
                continue;
            }

            if (i > start)
            {
                nalus.emplace_back(data.begin() + static_cast<ptrdiff_t>(start),
                                   data.begin() + static_cast<ptrdiff_t>(i));
            }
            i += startCode4 ? 4 : 3;
            start = i;
        }
        if (start < data.size())
        {
            nalus.emplace_back(data.begin() + static_cast<ptrdiff_t>(start),
                               data.end());
        }
        return nalus;
    }

    bool IsParameterSet(const std::vector<uint8_t>& nalu, const std::string& mime)
    {
        if (nalu.empty())
        {
            return false;
        }

        if (mime.find("hevc") != std::string::npos)
        {
            uint8_t type = static_cast<uint8_t>((nalu[0] & 0x7E) >> 1);
            return type == 32 || type == 33 || type == 34;
        }

        uint8_t type = static_cast<uint8_t>(nalu[0] & 0x1F);
        return type == 7 || type == 8;
    }

    std::vector<uint8_t> ExtractParameterSets(
        const std::vector<uint8_t>& data,
        const std::string& mime)
    {
        auto nalus = SplitNalUnits(data);
        int first = -1;
        for (int i = 0; i < static_cast<int>(nalus.size()); ++i)
        {
            if (IsParameterSet(nalus[i], mime))
            {
                first = i;
                break;
            }
        }
        if (first < 0)
        {
            return {};
        }

        int end = first;
        while (end < static_cast<int>(nalus.size()) && IsParameterSet(nalus[end], mime))
        {
            ++end;
        }
        if (end == first)
        {
            return {};
        }

        std::vector<uint8_t> out;
        for (int i = first; i < end; ++i)
        {
            out.insert(out.end(), kStartCode4, kStartCode4 + 4);
            out.insert(out.end(), nalus[i].begin(), nalus[i].end());
        }
        return out;
    }

    std::vector<uint8_t> WithStartCode(const std::vector<uint8_t>& nalu)
    {
        std::vector<uint8_t> out;
        out.reserve(nalu.size() + 4);
        out.insert(out.end(), kStartCode4, kStartCode4 + 4);
        out.insert(out.end(), nalu.begin(), nalu.end());
        return out;
    }

    void StopDecoderLocked()
    {
        if (gDecoderThread.joinable())
        {
            gDecoderRunning.store(false);
            gDecoderThread.join();
        }
        if (gDecoder != nullptr)
        {
            AMediaCodec_stop(gDecoder);
            AMediaCodec_delete(gDecoder);
            gDecoder = nullptr;
        }
        gDecoderCsdBuffers.clear();
        gConfiguredCsd.clear();
        gDecoderConfigured = false;
    }

    void DecoderLoop()
    {
        while (gDecoderRunning.load())
        {
            AMediaCodec* codec = gDecoder;
            if (codec == nullptr)
            {
                std::this_thread::sleep_for(std::chrono::milliseconds(5));
                continue;
            }

            AMediaCodecBufferInfo info{};
            ssize_t index = AMediaCodec_dequeueOutputBuffer(codec, &info, 10000);
            if (index == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED)
            {
                AMediaFormat* format = AMediaCodec_getOutputFormat(codec);
                if (format != nullptr)
                {
                    int32_t width = 0;
                    int32_t height = 0;
                    AMediaFormat_getInt32(format, AMEDIAFORMAT_KEY_WIDTH, &width);
                    AMediaFormat_getInt32(format, AMEDIAFORMAT_KEY_HEIGHT, &height);
                    VS_DLOGI("decoder output format %dx%d", width, height);
                    AMediaFormat_delete(format);
                }
                continue;
            }
            if (index < 0)
            {
                continue;
            }

            if (gOutputWindow == nullptr)
            {
                VS_DLOGE("decoder output Surface missing; software decode is disabled");
                AMediaCodec_releaseOutputBuffer(codec, index, false);
                continue;
            }

            AMediaCodec_releaseOutputBuffer(codec, index, true);
        }
    }

    bool ConfigureDecoder()
    {
        std::lock_guard<std::mutex> lock(gDecoderMutex);
        if (!gDecoderActive || gCsd.empty())
        {
            return false;
        }
        if (gDecoderConfigured && gConfiguredCsd == gCsd)
        {
            return true;
        }
        if (gOutputWindow == nullptr)
        {
            VS_DLOGE("decoder requires output Surface; software decode is disabled");
            return false;
        }

        auto nalus = SplitNalUnits(gCsd);
        if (nalus.empty())
        {
            VS_DLOGE("No NALUs extracted from CSD");
            return false;
        }

        bool isHevc = gMime.find("hevc") != std::string::npos;
        int minNalus = isHevc ? 3 : 2;
        if (static_cast<int>(nalus.size()) < minNalus)
        {
            VS_DLOGE("CSD has %zu NALUs, need %d for %s",
                     nalus.size(), minNalus, gMime.c_str());
            return false;
        }

        int width = 1920;
        int height = 1080;

        StopDecoderLocked();

        AMediaCodec* decoder = AMediaCodec_createDecoderByType(gMime.c_str());
        if (decoder == nullptr)
        {
            VS_DLOGE("AMediaCodec_createDecoderByType failed");
            return false;
        }

        AMediaFormat* format = AMediaFormat_new();
        AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, gMime.c_str());
        AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_WIDTH, width);
        AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_HEIGHT, height);
        AMediaFormat_setInt32(format, "low-latency", 1);

        gDecoderCsdBuffers.clear();
        int csdCount = std::min(static_cast<int>(nalus.size()), isHevc ? 3 : 2);
        for (int i = 0; i < csdCount; ++i)
        {
            gDecoderCsdBuffers.push_back(WithStartCode(nalus[i]));
        }
        for (int i = 0; i < csdCount; ++i)
        {
            std::string key = "csd-" + std::to_string(i);
            AMediaFormat_setBuffer(
                format,
                key.c_str(),
                gDecoderCsdBuffers[i].data(),
                gDecoderCsdBuffers[i].size());
        }

        media_status_t status = AMediaCodec_configure(
            decoder,
            format,
            gOutputWindow,
            nullptr,
            0);
        AMediaFormat_delete(format);
        if (status != AMEDIA_OK)
        {
            VS_DLOGE("decoder configure failed: %d", status);
            AMediaCodec_delete(decoder);
            return false;
        }

        status = AMediaCodec_start(decoder);
        if (status != AMEDIA_OK)
        {
            VS_DLOGE("decoder start failed: %d", status);
            AMediaCodec_delete(decoder);
            return false;
        }

        gDecoder = decoder;
        gDecoderConfigured = true;
        gConfiguredCsd = gCsd;
        gDecoderRunning.store(true);
        gDecoderThread = std::thread(DecoderLoop);
        VS_DLOGI("decoder configured %dx%d %s", width, height, gMime.c_str());
        return true;
    }
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_DecoderStart(const char* mime)
{
    std::lock_guard<std::mutex> lock(gDecoderMutex);
    if (gDecoderActive)
    {
        return 1;
    }

    StopDecoderLocked();
    gDecoderActive = true;
    gMime = mime != nullptr ? mime : "video/avc";
    gCsd.clear();
    gLastFrameId = -1;
    gDamaged = false;
    gLastIdrRequestMs = 0;
    gProcessThread = std::thread([]()
    {
        while (gDecoderActive)
        {
            VSMedia_DecoderProcessPackets();
            std::this_thread::sleep_for(std::chrono::milliseconds(1));
        }
    });
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_DecoderFeedPacket(
    const uint8_t* packet,
    int size)
{
    if (packet == nullptr || size < kFrameHeaderSize)
    {
        return 0;
    }

    int32_t frameId = static_cast<int32_t>(ReadU32(packet));
    uint16_t flags = static_cast<uint16_t>(ReadU16(packet + 16));
    if ((flags & kFlagCodecAvc) != 0)
    {
        gMime = "video/avc";
    }
    else if ((flags & kFlagCodecHevc) != 0)
    {
        gMime = "video/hevc";
    }

    int64_t ptsUs = static_cast<int64_t>(ReadU32(packet + 4)) << 32 |
                    static_cast<int64_t>(ReadU32(packet + 8));
    uint32_t naluSize = ReadU32(packet + 12);
    int payloadSize = static_cast<int>(std::min<uint32_t>(
        naluSize, static_cast<uint32_t>(size - kFrameHeaderSize)));
    const uint8_t* payload = packet + kFrameHeaderSize;

    if ((flags & kFlagConfig) != 0)
    {
        gCsd.assign(payload, payload + payloadSize);
        return ConfigureDecoder() ? 1 : 0;
    }

    if (!gDecoderConfigured)
    {
        if ((flags & kFlagIdr) != 0)
        {
            auto extracted = ExtractParameterSets(
                std::vector<uint8_t>(payload, payload + payloadSize), gMime);
            if (!extracted.empty())
            {
                gCsd = std::move(extracted);
            }
            if (!ConfigureDecoder())
            {
                return 0;
            }
        }
        else
        {
            return 0;
        }
    }

    if (gLastFrameId >= 0 && frameId > gLastFrameId + 1 && (flags & kFlagIdr) == 0)
    {
        VS_DLOGE("FRAME GAP lost %d frame(s) (%d -> %d), waiting for IDR",
                 frameId - gLastFrameId - 1, gLastFrameId, frameId);
        gDamaged = true;
    }
    if (frameId > gLastFrameId)
    {
        gLastFrameId = frameId;
    }

    if (gDamaged)
    {
        if ((flags & kFlagIdr) != 0)
        {
            gDamaged = false;
            VS_DLOGI("IDR received, decoder resumed");
        }
        else
        {
            int64_t now = NowMs();
            if (now - gLastIdrRequestMs >= 200)
            {
                gLastIdrRequestMs = now;
                VSMedia_UdpSendIdrRequest();
            }
            return 0;
        }
    }

    AMediaCodec* codec = gDecoder;
    if (codec == nullptr)
    {
        return 0;
    }

    ssize_t index = AMediaCodec_dequeueInputBuffer(codec, 10000);
    if (index < 0)
    {
        return 0;
    }

    size_t bufferSize = 0;
    uint8_t* buffer = AMediaCodec_getInputBuffer(codec, index, &bufferSize);
    if (buffer == nullptr || bufferSize < static_cast<size_t>(payloadSize))
    {
        VS_DLOGE("getInputBuffer failed buffer=%p size=%zu need=%d",
                 buffer, bufferSize, payloadSize);
        return 0;
    }

    std::memcpy(buffer, payload, static_cast<size_t>(payloadSize));
    media_status_t status = AMediaCodec_queueInputBuffer(
        codec,
        index,
        0,
        static_cast<size_t>(payloadSize),
        static_cast<uint64_t>(ptsUs),
        0);
    return status == AMEDIA_OK ? 1 : 0;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_DecoderProcessPackets()
{
    static thread_local std::vector<uint8_t> buffer(256 * 1024);
    int processed = 0;
    while (true)
    {
        int size = 0;
        int result = VSMedia_UdpPollPacket(buffer.data(), static_cast<int>(buffer.size()), &size);
        if (result == 0)
        {
            break;
        }
        if (result < 0)
        {
            if (size > static_cast<int>(buffer.size()))
            {
                buffer.resize(static_cast<size_t>(size));
                continue;
            }
            continue;
        }
        if (size < kFrameHeaderSize)
        {
            continue;
        }
        if (VSMedia_DecoderFeedPacket(buffer.data(), size) == 1)
        {
            ++processed;
        }
    }
    return processed;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_DecoderStop()
{
    std::lock_guard<std::mutex> lock(gDecoderMutex);
    if (!gDecoderActive)
    {
        return 1;
    }

    gDecoderActive = false;
    if (gProcessThread.joinable())
    {
        gProcessThread.join();
    }
    StopDecoderLocked();
    if (gOutputWindow != nullptr)
    {
        ANativeWindow_release(gOutputWindow);
        gOutputWindow = nullptr;
    }
    gCsd.clear();
    gLastFrameId = -1;
    gDamaged = false;
    gLastIdrRequestMs = 0;
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_DecoderSetOutputSurface(void* surface)
{
    std::lock_guard<std::mutex> lock(gDecoderMutex);
    if (gOutputWindow != nullptr)
    {
        ANativeWindow_release(gOutputWindow);
        gOutputWindow = nullptr;
    }
    if (surface == nullptr)
    {
        return 1;
    }

    JavaVM* javaVm = VSMedia_GetJavaVm();
    if (javaVm == nullptr)
    {
        return 0;
    }

    JNIEnv* env = nullptr;
    if (javaVm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) != JNI_OK)
    {
        if (javaVm->AttachCurrentThread(&env, nullptr) != JNI_OK)
        {
            return 0;
        }
    }
    if (env == nullptr)
    {
        return 0;
    }

    gOutputWindow = ANativeWindow_fromSurface(env, static_cast<jobject>(surface));
    VS_DLOGI("decoder output Surface set: %p", gOutputWindow);
    return gOutputWindow != nullptr ? 1 : 0;
}
