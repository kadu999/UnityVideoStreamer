#include "IUnityInterface.h"

#include <android/log.h>
#include <arpa/inet.h>
#include <netinet/in.h>
#include <sys/socket.h>
#include <unistd.h>

#include <algorithm>
#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <cstring>
#include <deque>
#include <mutex>
#include <thread>
#include <unordered_map>
#include <vector>

#define VS_UDP_LOG_TAG "VideoStreamNativeUdp"
#define VS_UDP_LOGI(...) __android_log_print(ANDROID_LOG_INFO, VS_UDP_LOG_TAG, __VA_ARGS__)

namespace
{
    constexpr int kUdpFragmentHeaderSize = 10;
    constexpr int kUdpMaxPayload = 1400;
    constexpr int kFrameHeaderSize = 18;

    constexpr uint16_t kFlagIdr = 0x0001;
    constexpr uint16_t kFlagConfig = 0x0002;
    constexpr uint16_t kFlagIdrRequest = 0x0040;
    constexpr uint16_t kFlagCodecAvc = 0x0010;
    constexpr uint16_t kFlagCodecHevc = 0x0020;

    std::mutex gUdpMutex;
    std::vector<sockaddr_in> gUdpTargets;
    int gUdpSocket = -1;
    std::atomic<bool> gUdpRunning{false};
    std::thread gUdpReceiveThread;
    std::mutex gUdpReceiveMutex;
    std::deque<std::vector<uint8_t>> gReceivedPackets;
    std::atomic<int> gIdrRequestCount{0};
    std::atomic<uint32_t> gLastSenderIp{0};
    std::atomic<uint16_t> gLastSenderPort{0};
    std::atomic<uint64_t> gUdpSentFrames{0};
    std::atomic<uint64_t> gUdpSentBytes{0};
    std::atomic<uint64_t> gUdpReceivedFrames{0};
    std::atomic<uint64_t> gUdpReceivedBytes{0};
    std::atomic<uint64_t> gUdpReceivedDatagrams{0};

    struct PendingFrame
    {
        int frameId = 0;
        int size = 0;
        int socketFd = -1;
        std::vector<std::vector<uint8_t>> fragments;
        std::vector<sockaddr_in> targets;
    };

    std::mutex gUdpSendMutex;
    std::condition_variable gUdpSendCv;
    std::deque<PendingFrame> gSendQueue;
    std::thread gUdpSendThread;
    std::atomic<bool> gUdpSendRunning{false};

    struct FragmentBuffer
    {
        int count = 0;
        std::vector<std::vector<uint8_t>> fragments;
        int received = 0;
        int64_t lastUpdateMs = 0;
    };

    std::unordered_map<uint32_t, FragmentBuffer> gFragmentBuffers;

    int64_t NowMs()
    {
        return std::chrono::duration_cast<std::chrono::milliseconds>(
            std::chrono::steady_clock::now().time_since_epoch()).count();
    }

    void WriteU16(uint8_t* dst, uint16_t value)
    {
        dst[0] = static_cast<uint8_t>(value >> 8);
        dst[1] = static_cast<uint8_t>(value);
    }

    void WriteU32(uint8_t* dst, uint32_t value)
    {
        dst[0] = static_cast<uint8_t>(value >> 24);
        dst[1] = static_cast<uint8_t>(value >> 16);
        dst[2] = static_cast<uint8_t>(value >> 8);
        dst[3] = static_cast<uint8_t>(value);
    }

    void WriteU64(uint8_t* dst, uint64_t value)
    {
        WriteU32(dst, static_cast<uint32_t>(value >> 32));
        WriteU32(dst + 4, static_cast<uint32_t>(value));
    }

    std::vector<uint8_t> BuildFramePacket(
        int frameId,
        int64_t ptsUs,
        const uint8_t* data,
        int size,
        bool isConfig,
        bool isKeyFrame,
        const char* mime)
    {
        uint16_t flags = 0;
        if (isConfig) flags |= kFlagConfig;
        if (isKeyFrame) flags |= kFlagIdr;
        flags |= std::strstr(mime, "hevc") != nullptr ? kFlagCodecHevc : kFlagCodecAvc;

        std::vector<uint8_t> packet(static_cast<size_t>(kFrameHeaderSize + size));
        WriteU32(packet.data(), static_cast<uint32_t>(frameId));
        WriteU64(packet.data() + 4, static_cast<uint64_t>(ptsUs));
        WriteU32(packet.data() + 12, static_cast<uint32_t>(size));
        WriteU16(packet.data() + 16, flags);
        if (size > 0)
        {
            std::memcpy(packet.data() + kFrameHeaderSize, data, static_cast<size_t>(size));
        }
        return packet;
    }

    std::vector<std::vector<uint8_t>> Fragment(
        const std::vector<uint8_t>& packet,
        uint32_t sequence,
        bool isIdr)
    {
        std::vector<std::vector<uint8_t>> fragments;
        uint16_t flags = isIdr ? kFlagIdr : 0;

        if (static_cast<int>(packet.size()) <= kUdpMaxPayload)
        {
            std::vector<uint8_t> datagram(kUdpFragmentHeaderSize + packet.size());
            WriteU16(datagram.data(), flags);
            WriteU16(datagram.data() + 2, 0);
            WriteU16(datagram.data() + 4, 1);
            WriteU32(datagram.data() + 6, sequence);
            std::memcpy(datagram.data() + kUdpFragmentHeaderSize, packet.data(), packet.size());
            fragments.push_back(std::move(datagram));
            return fragments;
        }

        int count = (static_cast<int>(packet.size()) + kUdpMaxPayload - 1) / kUdpMaxPayload;
        for (int index = 0; index < count; ++index)
        {
            int start = index * kUdpMaxPayload;
            int end = std::min(start + kUdpMaxPayload, static_cast<int>(packet.size()));
            int payloadSize = end - start;
            std::vector<uint8_t> datagram(kUdpFragmentHeaderSize + payloadSize);
            WriteU16(datagram.data(), flags);
            WriteU16(datagram.data() + 2, static_cast<uint16_t>(index));
            WriteU16(datagram.data() + 4, static_cast<uint16_t>(count));
            WriteU32(datagram.data() + 6, sequence);
            std::memcpy(datagram.data() + kUdpFragmentHeaderSize, packet.data() + start, payloadSize);
            fragments.push_back(std::move(datagram));
        }
        return fragments;
    }

    void EnqueueReceivedPacket(std::vector<uint8_t> packet)
    {
        if (packet.size() < static_cast<size_t>(kFrameHeaderSize))
        {
            return;
        }

        const size_t packetSize = packet.size();
        uint32_t flags = (static_cast<uint32_t>(packet[16]) << 8) |
                         static_cast<uint32_t>(packet[17]);
        if ((flags & 0x0040) != 0)
        {
            gIdrRequestCount.fetch_add(1);
        }
        else
        {
            gUdpReceivedFrames.fetch_add(1);
            gUdpReceivedBytes.fetch_add(packetSize);
        }

        std::lock_guard<std::mutex> lock(gUdpReceiveMutex);
        gReceivedPackets.push_back(std::move(packet));
    }

    void HandleFragment(const uint8_t* data, int length)
    {
        if (length < kUdpFragmentHeaderSize)
        {
            return;
        }
        gUdpReceivedDatagrams.fetch_add(1);

        uint16_t index = static_cast<uint16_t>(
            (static_cast<uint32_t>(data[2]) << 8) | data[3]);
        uint16_t count = static_cast<uint16_t>(
            (static_cast<uint32_t>(data[4]) << 8) | data[5]);
        uint32_t sequence = (static_cast<uint32_t>(data[6]) << 24) |
                            (static_cast<uint32_t>(data[7]) << 16) |
                            (static_cast<uint32_t>(data[8]) << 8) |
                            static_cast<uint32_t>(data[9]);

        int payloadSize = length - kUdpFragmentHeaderSize;
        if (count <= 0 || index >= count || payloadSize <= 0)
        {
            // 裸 FrameProtocol 包（无分片头）：gateway 的 IDR 请求(0x0040)和
            // disconnect(0x0080) 以 18 字节原包发出，bytes 4-5 是 ptsUs 高位=0，
            // 会被误读成 count=0 而在此被丢弃——IDR 请求从未到达编码器，
            // 丢帧后只能等 2s 周期关键帧恢复。0x0040 只计数，不喂给解码器。
            if (length >= kFrameHeaderSize)
            {
                uint32_t rawFlags = (static_cast<uint32_t>(data[16]) << 8) |
                                    static_cast<uint32_t>(data[17]);
                if ((rawFlags & kFlagIdrRequest) != 0)
                {
                    gIdrRequestCount.fetch_add(1);
                }
            }
            return;
        }

        std::vector<uint8_t> payload(data + kUdpFragmentHeaderSize, data + length);
        if (count == 1)
        {
            EnqueueReceivedPacket(std::move(payload));
            return;
        }

        auto it = gFragmentBuffers.find(sequence);
        if (it == gFragmentBuffers.end() || it->second.count != count)
        {
            FragmentBuffer buffer;
            buffer.count = count;
            buffer.fragments.resize(count);
            buffer.lastUpdateMs = NowMs();
            it = gFragmentBuffers.emplace(sequence, std::move(buffer)).first;
        }

        FragmentBuffer& buffer = it->second;
        if (!buffer.fragments[index].empty())
        {
            return;
        }

        buffer.fragments[index] = std::move(payload);
        buffer.received++;
        buffer.lastUpdateMs = NowMs();

        // 超时清理：丢分片会导致该 sequence 的缓冲永远等不全（旧实现无清理，
        // 长时间有损链路下内存持续增长）。与 gateway 的 Reassembler 一致：超过
        // 64 个在途缓冲时清掉 300ms 未更新的。
        if (gFragmentBuffers.size() > 64)
        {
            const int64_t now = NowMs();
            for (auto it = gFragmentBuffers.begin(); it != gFragmentBuffers.end();)
            {
                if (now - it->second.lastUpdateMs > 300)
                {
                    it = gFragmentBuffers.erase(it);
                }
                else
                {
                    ++it;
                }
            }
        }

        if (buffer.received != count)
        {
            return;
        }

        int totalSize = 0;
        for (const auto& fragment : buffer.fragments)
        {
            totalSize += static_cast<int>(fragment.size());
        }

        std::vector<uint8_t> packet;
        packet.reserve(totalSize);
        for (const auto& fragment : buffer.fragments)
        {
            packet.insert(packet.end(), fragment.begin(), fragment.end());
        }
        gFragmentBuffers.erase(sequence);
        EnqueueReceivedPacket(std::move(packet));
    }

    void UdpReceiveLoop()
    {
        std::vector<uint8_t> buffer(64 * 1024);
        sockaddr_in remote{};
        socklen_t remoteSize = sizeof(remote);

        while (gUdpRunning.load())
        {
            ssize_t length = recvfrom(
                gUdpSocket,
                buffer.data(),
                buffer.size(),
                0,
                reinterpret_cast<sockaddr*>(&remote),
                &remoteSize);
            if (length <= 0)
            {
                if (!gUdpRunning.load())
                {
                    break;
                }
                continue;
            }

            gLastSenderIp.store(ntohl(remote.sin_addr.s_addr));
            gLastSenderPort.store(ntohs(remote.sin_port));
            HandleFragment(buffer.data(), static_cast<int>(length));

            static int64_t lastRecvStatsMs = NowMs();
            static uint64_t lastRecvFrames = 0;
            static uint64_t lastRecvBytes = 0;
            static uint64_t lastRecvDatagrams = 0;
            const int64_t nowMs = NowMs();
            if (nowMs - lastRecvStatsMs >= 5000)
            {
                const double dtSec = (nowMs - lastRecvStatsMs) / 1000.0;
                const uint64_t frames = gUdpReceivedFrames.load();
                const uint64_t bytes = gUdpReceivedBytes.load();
                const uint64_t datagrams = gUdpReceivedDatagrams.load();
                const uint64_t datagramDelta = datagrams - lastRecvDatagrams;
                const double fps = (frames - lastRecvFrames) / dtSec;
                const double mbps = (bytes - lastRecvBytes) * 8.0 / dtSec / 1000000.0;
                VS_UDP_LOGI("recv stats fps=%.1f frames=%llu bytes=%llu datagrams=%llu bw=%.2fMbps",
                            fps,
                            static_cast<unsigned long long>(frames),
                            static_cast<unsigned long long>(bytes),
                            static_cast<unsigned long long>(datagramDelta),
                            mbps);
                lastRecvStatsMs = nowMs;
                lastRecvFrames = frames;
                lastRecvBytes = bytes;
                lastRecvDatagrams = datagrams;
            }
        }
    }

    void UdpSendLoop()
    {
        while (gUdpSendRunning.load())
        {
            PendingFrame frame;
            {
                std::unique_lock<std::mutex> lock(gUdpSendMutex);
                gUdpSendCv.wait(lock, []()
                {
                    return !gSendQueue.empty() || !gUdpSendRunning.load();
                });
                if (!gUdpSendRunning.load())
                {
                    break;
                }
                frame = std::move(gSendQueue.front());
                gSendQueue.pop_front();
            }

            int sent = 0;
            for (size_t i = 0; i < frame.fragments.size(); ++i)
            {
                const auto& datagram = frame.fragments[i];
                for (const auto& target : frame.targets)
                {
                    ssize_t result = sendto(
                        frame.socketFd,
                        datagram.data(),
                        datagram.size(),
                        0,
                        reinterpret_cast<const sockaddr*>(&target),
                        sizeof(target));
                    if (result == static_cast<ssize_t>(datagram.size()))
                    {
                        ++sent;
                    }
                }

                if (i + 1 < frame.fragments.size())
                {
                    std::this_thread::sleep_for(std::chrono::microseconds(300));
                }
            }

            if (sent > 0 && (frame.frameId <= 5 || frame.frameId % 60 == 0))
            {
                uint8_t head[8] = {};
                const auto& first = frame.fragments.front();
                const size_t payloadStart =
                    static_cast<size_t>(kUdpFragmentHeaderSize + kFrameHeaderSize);
                if (first.size() >= payloadStart)
                {
                    std::memcpy(head, first.data() + payloadStart,
                                std::min<size_t>(sizeof(head), first.size() - payloadStart));
                }
                VS_UDP_LOGI("udp sent frame=%d size=%d fragments=%zu datagrams=%d targets=%zu "
                            "head=%02x%02x%02x%02x %02x%02x%02x%02x",
                            frame.frameId, frame.size, frame.fragments.size(), sent,
                            frame.targets.size(),
                            head[0], head[1], head[2], head[3],
                            head[4], head[5], head[6], head[7]);
            }

            gUdpSentFrames.fetch_add(1);
            gUdpSentBytes.fetch_add(static_cast<uint64_t>(frame.size));

            static int64_t lastSendStatsMs = NowMs();
            static uint64_t lastSendFrames = 0;
            static uint64_t lastSendBytes = 0;
            const int64_t nowMs = NowMs();
            if (nowMs - lastSendStatsMs >= 5000)
            {
                const double dtSec = (nowMs - lastSendStatsMs) / 1000.0;
                const uint64_t frames = gUdpSentFrames.load();
                const uint64_t bytes = gUdpSentBytes.load();
                const double fps = (frames - lastSendFrames) / dtSec;
                const double mbps = (bytes - lastSendBytes) * 8.0 / dtSec / 1000000.0;
                VS_UDP_LOGI("send stats fps=%.1f frames=%llu bytes=%llu bw=%.2fMbps",
                            fps,
                            static_cast<unsigned long long>(frames),
                            static_cast<unsigned long long>(bytes),
                            mbps);
                lastSendStatsMs = nowMs;
                lastSendFrames = frames;
                lastSendBytes = bytes;
            }
        }
    }
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpStart(int localPort)
{
    std::lock_guard<std::mutex> lock(gUdpMutex);
    if (gUdpSocket >= 0)
    {
        return 1;
    }

    int fd = socket(AF_INET, SOCK_DGRAM, 0);
    if (fd < 0)
    {
        return 0;
    }

    sockaddr_in addr{};
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_ANY);
    addr.sin_port = htons(static_cast<uint16_t>(localPort));
    if (bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0)
    {
        close(fd);
        return 0;
    }

    int sendBuffer = 1024 * 1024;
    setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &sendBuffer, sizeof(sendBuffer));
    int receiveBuffer = 2 * 1024 * 1024;
    setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &receiveBuffer, sizeof(receiveBuffer));

    gUdpSocket = fd;
    gUdpRunning.store(true);
    gUdpSendRunning.store(true);
    gUdpReceiveThread = std::thread(UdpReceiveLoop);
    gUdpSendThread = std::thread(UdpSendLoop);
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpStop()
{
    {
        std::lock_guard<std::mutex> lock(gUdpMutex);
        gUdpRunning.store(false);
        gUdpSendRunning.store(false);
        if (gUdpSocket >= 0)
        {
            close(gUdpSocket);
            gUdpSocket = -1;
        }
        gUdpTargets.clear();
    }
    gUdpSendCv.notify_all();
    if (gUdpReceiveThread.joinable())
    {
        gUdpReceiveThread.join();
    }
    if (gUdpSendThread.joinable())
    {
        gUdpSendThread.join();
    }
    {
        std::lock_guard<std::mutex> lock(gUdpSendMutex);
        gSendQueue.clear();
    }
    {
        std::lock_guard<std::mutex> receiveLock(gUdpReceiveMutex);
        gReceivedPackets.clear();
    }
    gIdrRequestCount.store(0);
    gLastSenderIp.store(0);
    gLastSenderPort.store(0);
    gUdpSentFrames.store(0);
    gUdpSentBytes.store(0);
    gUdpReceivedFrames.store(0);
    gUdpReceivedBytes.store(0);
    gUdpReceivedDatagrams.store(0);
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpAddTarget(const char* ip, int port)
{
    if (ip == nullptr || port <= 0 || port > 65535)
    {
        return 0;
    }

    sockaddr_in addr{};
    addr.sin_family = AF_INET;
    addr.sin_port = htons(static_cast<uint16_t>(port));
    if (inet_pton(AF_INET, ip, &addr.sin_addr) != 1)
    {
        return 0;
    }

    std::lock_guard<std::mutex> lock(gUdpMutex);
    gUdpTargets.push_back(addr);
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpSendFrame(
    int frameId,
    int64_t ptsUs,
    const uint8_t* data,
    int size,
    bool isConfig,
    bool isKeyFrame,
    const char* mime,
    uint32_t sequence)
{
    if (data == nullptr || size <= 0 || mime == nullptr)
    {
        return 0;
    }

    auto packet = BuildFramePacket(frameId, ptsUs, data, size, isConfig, isKeyFrame, mime);
    auto fragments = Fragment(packet, sequence, isKeyFrame || isConfig);

    PendingFrame frame;
    {
        std::lock_guard<std::mutex> lock(gUdpMutex);
        if (gUdpSocket < 0 || gUdpTargets.empty())
        {
            return 0;
        }
        frame.frameId = frameId;
        frame.size = size;
        frame.socketFd = gUdpSocket;
        frame.targets = gUdpTargets;
    }
    frame.fragments = std::move(fragments);

    {
        std::lock_guard<std::mutex> lock(gUdpSendMutex);
        if (!gUdpSendRunning.load())
        {
            return 0;
        }
        if (gSendQueue.size() >= 120)
        {
            gSendQueue.pop_front();
        }
        gSendQueue.push_back(std::move(frame));
    }
    gUdpSendCv.notify_one();

    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpPollPacket(
    uint8_t* buffer,
    int capacity,
    int* size)
{
    std::vector<uint8_t> packet;
    {
        std::lock_guard<std::mutex> lock(gUdpReceiveMutex);
        if (gReceivedPackets.empty())
        {
            return 0;
        }
        if (buffer == nullptr || capacity < static_cast<int>(gReceivedPackets.front().size()))
        {
            if (size != nullptr)
            {
                *size = static_cast<int>(gReceivedPackets.front().size());
            }
            return -1;
        }
        packet = std::move(gReceivedPackets.front());
        gReceivedPackets.pop_front();
    }

    std::memcpy(buffer, packet.data(), packet.size());
    if (size != nullptr)
    {
        *size = static_cast<int>(packet.size());
    }
    return 1;
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpTakeIdrRequest()
{
    return gIdrRequestCount.exchange(0);
}

// 摄像头接收节奏测量：gUdpReceivedFrames 是收到并重装完成的 FrameProtocol 帧数
//（不含控制包）。C# 侧每秒取差值即可得 fed fps。
extern "C" UNITY_INTERFACE_EXPORT uint64_t VSMedia_UdpGetReceivedFrames()
{
    return gUdpReceivedFrames.load();
}

extern "C" UNITY_INTERFACE_EXPORT int VSMedia_UdpSendIdrRequest()
{
    std::lock_guard<std::mutex> lock(gUdpMutex);
    if (gUdpSocket < 0)
    {
        return 0;
    }

    std::vector<uint8_t> packet(static_cast<size_t>(kFrameHeaderSize));
    WriteU32(packet.data(), 0);
    WriteU64(packet.data() + 4, 0);
    WriteU32(packet.data() + 12, 0);
    WriteU16(packet.data() + 16, kFlagIdrRequest);

    int sent = 0;
    // 优先发给配置的目标（gateway:9999 的 FrameReceiver 端口）：摄像头帧来自
    // gateway 的临时上游 socket（随机端口，只发不收），旧实现回给 last-sender
    // 的 IDR 请求实际落在收不到数据的端口上，等于丢失。目标列表为空时回退
    // last-sender（保持原有行为）。
    if (!gUdpTargets.empty())
    {
        for (const auto& target : gUdpTargets)
        {
            ssize_t result = sendto(
                gUdpSocket,
                packet.data(),
                packet.size(),
                0,
                reinterpret_cast<const sockaddr*>(&target),
                sizeof(target));
            if (result == static_cast<ssize_t>(packet.size()))
            {
                ++sent;
            }
        }
        return sent > 0 ? 1 : 0;
    }

    uint32_t ip = gLastSenderIp.load();
    uint16_t port = gLastSenderPort.load();
    if (ip == 0 || port == 0)
    {
        return 0;
    }

    sockaddr_in target{};
    target.sin_family = AF_INET;
    target.sin_addr.s_addr = htonl(ip);
    target.sin_port = htons(port);

    ssize_t result = sendto(
        gUdpSocket,
        packet.data(),
        packet.size(),
        0,
        reinterpret_cast<const sockaddr*>(&target),
        sizeof(target));
    return result == static_cast<ssize_t>(packet.size()) ? 1 : 0;
}
